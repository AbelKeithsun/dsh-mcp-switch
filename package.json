{
  "name": "@local/dsh-mcp-switch",
  "version": "0.1.1",
  "private": true,
  "description": "Harness 设置的「MCP 服务」页：逐个启用/停用本 profile 的 MCP 服务器，运行时热生效。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbelKeithsun/dsh-mcp-switch.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "meta": {
    "title": "MCP 服务开关",
    "description": "在设置里逐个开关 MCP 服务器（rea / gitnexus / superting 等），无需重启。"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "scripts/*.mjs"
  ],
  "scripts": {
    "test": "node --test tests/client.test.mjs tests/compat.test.mjs",
    "compat": "node scripts/check-compat.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": "^0.2.0-rc.2"
    },
    "testedWith": [
      "0.2.0-rc.2"
    ],
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

